# Copy to .env and fill in. .env is in .gitignore: never commit it.
# Both the voice worker (voice/) and the web page (web/) read this one file.

# --- LiveKit Cloud (https://cloud.livekit.io -> Settings -> Keys) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Speech to text (https://console.deepgram.com) ---
DEEPGRAM_API_KEY=

# --- LLM (https://console.groq.com/keys) ---
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# LLM_REASONING_EFFORT=none        # Groq switch that turns Qwen thinking off; empty = do not send
# LLM_MAX_TOKENS=120               # reply cap; Groq free tier rejects requests that could exceed 1,000 output tokens/min

# --- Text to speech (https://play.cartesia.ai) ---
CARTESIA_API_KEY=
OMAR_VOICE_ID=                     # a Cartesia voice ID; empty = Cartesia's default voice
# CARTESIA_MODEL=sonic-3
# Voice mood: base emotion for every line (the LLM adds per-sentence emotion tags),
# pace (0.6-1.5), and the mood of scripted lines.
# TTS_EMOTION=content
# TTS_SPEED=1.05
# SCRIPT_EMOTION=happy

# ElevenLabs (optional): used when the page picks an ElevenLabs voice.
# Without it, ElevenLabs voices fall back to the default Cartesia voice.
ELEVEN_API_KEY=
# ELEVEN_MODEL=eleven_v4_turbo
# ELEVEN_STABILITY=0.3

# --- Optional: backup LLM (decision D4). Set it and DeepSeek takes over when Groq fails. ---
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# --- Optional: Cerebras LLM (LLM_PROVIDER=cerebras, or "llm":"cerebras" per call) ---
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b
# CEREBRAS_REASONING_EFFORT=low     # gpt-oss always reasons; low keeps it short
# CEREBRAS_MAX_TOKENS=600           # reasoning tokens count against this cap

# --- Turn detection: one decider at a time ---
# TURN_MODE=flux                   # flux = Deepgram Flux decides | livekit = LiveKit turn detector decides
# LIVEKIT_TURN_MODEL=v1-mini       # livekit mode only: v1-mini (local, free) | v1 (LiveKit Cloud)
# ENDPOINTING_MIN_DELAY=           # seconds; default 0 (flux) or 0.3 (livekit)
# FLUX_EOT_THRESHOLD=0.7           # 0.5-0.9: higher = surer, slower (0.8 measured up to 2.8 s waits)
# FLUX_EAGER_EOT_THRESHOLD=0       # 0.3-0.7: Flux "probably done" signal that starts a preemptive draft; 0 = off
# DEEPGRAM_STT_URL=                # e.g. an EU endpoint; empty = Deepgram default

# --- Behaviour switches ---
# PREEMPTIVE_GENERATION=off        # on doubles Groq token use; keep off on the free tier
# PREEMPTIVE_TTS=off               # on = the voice starts on the draft too (costs TTS characters for dropped drafts)
# HINDI=off                        # on = every call allows Hindi (Flux multilingual STT); the page can choose per call
# TTS_ENGINE=                      # deepgram = Deepgram Aura voice for every line (turn tests: no ElevenLabs credits)
# The page or evals/turn_bench.py can pick a preset per call: "turn": flux | flux-eager | livekit-v1
# OUTPUT_GUARD=on                  # sentence guard (no prices, durations, early "booked", AI denial)
# FAKE_CALENDAR_TAKEN_RATE=0       # 0-1: chance a slot is "just taken" at booking (tests the re-offer path)
# FAKE_CALENDAR_ERROR_RATE=0       # 0-1: chance the calendar fails (tests the booking-link path)

# --- Worker identity: the web token dispatches this agent name ---
# OMAR_AGENT_NAME=omar             # set empty for automatic dispatch (e.g. LiveKit Agents Playground)
